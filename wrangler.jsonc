{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fable-pwa",
  "main": "worker.js",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v1/*"]
  },
  "vars": {
    "FABLE_BACKEND_ORIGIN": "https://fable-api-eosin.vercel.app"
  }
}
